{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "PowerShell(python -m pytest*)",
      "Bash(python main.py --executar:*)",
      "PowerShell(python main.py --executar*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
