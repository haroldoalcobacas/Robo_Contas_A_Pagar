# Modelo de configuração do Robô de Contas a Pagar.
# O jeito mais fácil é abrir o painel (python main.py --config) e clicar em
# "Salvar configurações", que cria o .env. Ou copie este arquivo:
#   copy .env.example .env
#
# Para testar com os e-mails de exemplo, nada precisa ser preenchido:
# ORIGEM_EMAILS=pasta e os relatórios desligados já bastam.
#
# Senhas: o painel as guarda no Gerenciador de Credenciais do Windows e
# deixa os campos *_SENHA / WHATSAPP_APIKEY vazios aqui.

# --- Execução ---
PASTA_EMAILS=dados/caixa_de_entrada
PASTA_SAIDA=saida
NOME_PLANILHA=contas_a_pagar.xlsx
# Vazio = data de hoje. Formato AAAA-MM-DD.
DATA_REFERENCIA=2026-09-20
# Guardar anexos em <saída>/anexos/<fornecedor>/<ano-mes>/
SALVAR_ANEXOS=sim

# --- Leitura de e-mail ---
# pasta = arquivos .eml locais | imap = caixa real
ORIGEM_EMAILS=pasta
IMAP_HOST=imap.gmail.com
IMAP_PORTA=993
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX
IMAP_DIAS=30

# --- Relatório ---
RELATORIO_EMAIL=nao
RELATORIO_WHATSAPP=nao
# diario | semanal | mensal
RELATORIO_FREQUENCIA=diario
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_DESTINATARIOS=
WHATSAPP_NUMERO=
WHATSAPP_APIKEY=

# --- Automação ---
AGENDA_HORA=08:00
